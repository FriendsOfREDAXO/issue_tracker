issue_tracker_help_good_1 = <strong>"Bug: Contact form doesn't send emails"</strong> - A specific problem with clear description
issue_tracker_help_good_2 = <strong>"Feature: Newsletter signup on homepage"</strong> - A concrete improvement suggestion
issue_tracker_help_good_3 = <strong>"Content: Update opening hours on contact page"</strong> - A clear editorial task
issue_tracker_help_bad_example = Bad Examples (don't do this!)
issue_tracker_help_bad_1 = <strong>"Various problems on the website"</strong> - Too vague, multiple topics mixed
issue_tracker_help_bad_2 = <strong>"Contact form doesn't work + newsletter + change opening hours"</strong> - Three different topics in one issue
issue_tracker_help_important_info = Important Information for the Technical Team
issue_tracker_help_tip_1 = <strong>What exactly is the problem?</strong> Describe specifically what doesn't work or what you need.
issue_tracker_help_tip_2 = <strong>Where does the problem occur?</strong> Indicate on which page or in which area the problem occurs.
issue_tracker_help_tip_3 = <strong>How can the problem be reproduced?</strong> Describe step by step how to see the problem yourself.
issue_tracker_help_tip_4 = <strong>Screenshots help!</strong> Add screenshots if possible - a picture is worth a thousand words.

